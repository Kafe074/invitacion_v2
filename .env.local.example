# Copia este archivo a .env.local y completa los valores.
# Project URL, anon key y service role key están en Supabase:
# Project Settings > API.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nunca exponer esta clave al cliente (no lleva NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña para entrar a /admin.
ADMIN_PASSWORD=
